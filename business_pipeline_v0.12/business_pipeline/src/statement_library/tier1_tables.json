  "schemas": {
    "cogm": {
      "request": "cost of goods manufactured|schedule of cost of goods",
      "required": [
        "direct_materials",
        "direct_labour",
        "manufacturing_overhead",
        "beginning_wip",
        "ending_wip"
      ],
      "require_all": [],
      "require_any": [],
      "figures": [
        [
          "direct_materials",
          "direct materials?(?:\\s+used)?",
          1
        ],
        [
          "direct_labour",
          "direct labou?r",
          1
        ],
        [
          "manufacturing_overhead",
          "(?:manufacturing|factory|production) overhead",
          1
        ],
        [
          "beginning_wip",
          "beginning (?:work in process|wip|work-in-process)",
          1
        ],
        [
          "ending_wip",
          "ending (?:work in process|wip|work-in-process)",
          1
        ],
        [
          "beginning_finished_goods",
          "beginning (?:finished goods|finished goods inventory)",
          1
        ],
        [
          "ending_finished_goods",
          "ending (?:finished goods|finished goods inventory)",
          1
        ],
        [
          "sales",
          "\\bsales\\b|\\brevenue\\b|\\bnet sales\\b",
          1
        ],
        [
          "selling_and_admin",
          "selling (?:and|&) admin\\w*|selling,? general|sg&a|operating expenses",
          1
        ]
      ]
    },
    "cash_flow_indirect": {
      "request": "cash ?flows?|statement of cash",
      "required": [],
      "require_all": [
        "net_income"
      ],
      "require_any": [
        "depreciation",
        "accounts_receivable",
        "inventory",
        "accounts_payable",
        "capital_expenditure",
        "proceeds_from_sale"
      ],
      "figures": [
        [
          "net_income",
          "net income",
          1
        ],
        [
          "depreciation",
          "depreciation(?!\\s+expense)",
          1
        ],
        [
          "gain_on_sale",
          "gain on (?:the )?(?:sale|disposal)",
          1
        ],
        [
          "loss_on_sale",
          "loss on (?:the )?(?:sale|disposal)",
          1
        ],
        [
          "accounts_receivable",
          "increase in (?:accounts? receivables?|receivables|a/?r)\\b",
          1
        ],
        [
          "accounts_receivable",
          "decrease in (?:accounts? receivables?|receivables|a/?r)\\b",
          -1
        ],
        [
          "inventory",
          "increase in (?:inventor(?:y|ies)|stock)\\b",
          1
        ],
        [
          "inventory",
          "decrease in (?:inventor(?:y|ies)|stock)\\b",
          -1
        ],
        [
          "prepaid_expenses",
          "increase in prepaid\\w*",
          1
        ],
        [
          "prepaid_expenses",
          "decrease in prepaid\\w*",
          -1
        ],
        [
          "accounts_payable",
          "increase in (?:accounts? payables?|payables|a/?p)\\b",
          1
        ],
        [
          "accounts_payable",
          "decrease in (?:accounts? payables?|payables|a/?p)\\b",
          -1
        ],
        [
          "accrued_liabilities",
          "increase in (?:accrued|accruals?)\\b",
          1
        ],
        [
          "accrued_liabilities",
          "decrease in (?:accrued|accruals?)\\b",
          -1
        ],
        [
          "capital_expenditure",
          "purchase(?:s)? of (?:equipment|property|plant|ppe|machinery|land|buildings?|vehicles?|fixed assets)",
          1
        ],
        [
          "proceeds_from_sale",
          "proceeds from (?:the )?(?:sale|disposal)",
          1
        ],
        [
          "shares_issued",
          "(?:issue|issued|issuance)(?:\\s+of)?\\s+(?:common\\s+|ordinary\\s+|share\\s+)?(?:stock|shares)",
          1
        ],
        [
          "dividends_paid",
          "dividends?[^;\\n]{0,30}?(?:paid|declared)",
          1
        ],
        [
          "beginning_cash",
          "beginning cash|cash at (?:the )?beginning|opening cash",
          1
        ]
      ]
    },
    "equity_statement": {
      "request": "(?:changes?\\s+in|statement\\s+of)\\s+(?:[a-z']+\\s+){0,2}equity|statement of (?:owners?'?|stockholders?'?|shareholders?'?)\\s*equity",
      "required": [],
      "require_all": [
        "net_income"
      ],
      "require_any": [
        "beginning_common_stock",
        "beginning_retained_earnings"
      ],
      "figures": [
        [
          "beginning_common_stock",
          "beginning (?:common|ordinary|share|preferred) (?:stock|capital)",
          1
        ],
        [
          "beginning_retained_earnings",
          "beginning retained earnings",
          1
        ],
        [
          "common_stock_issued",
          "(?:common|ordinary|share|preferred) (?:stock|capital) (?:issued|issue)",
          1
        ],
        [
          "net_income",
          "net income",
          1
        ],
        [
          "dividends",
          "dividends?",
          1
        ],
        [
          "other_comprehensive_income",
          "other comprehensive income",
          1
        ]
      ]
    },
    "bank_reconciliation": {
      "request": "bank reconciliation|reconcil\\w* (?:the )?(?:bank|cash)",
      "required": [],
      "require_all": [
        "bank_statement_balance",
        "book_cash_balance"
      ],
      "require_any": [],
      "figures": [
        [
          "bank_statement_balance",
          "bank statement balance|balance per bank|bank balance|balance per the bank",
          1
        ],
        [
          "book_cash_balance",
          "book cash balance|balance per books?|book balance|cash balance per books?|balance per the books?",
          1
        ],
        [
          "deposits_in_transit",
          "deposits? in transit",
          1
        ],
        [
          "outstanding_checks",
          "outstanding checks?",
          1
        ],
        [
          "bank_service_charge",
          "(?:bank )?service charge",
          1
        ],
        [
          "nsf_check",
          "nsf(?:\\s+customer)?\\s+check|nsf",
          1
        ],
        [
          "note_collected",
          "note collected(?:\\s+by (?:the )?bank)?",
          1
        ],
        [
          "interest_earned",
          "interest earned",
          1
        ],
        [
          "book_error",
          "book error|error in (?:the )?(?:books|cash)",
          1
        ]
      ]
    },
    "asset_disposal": {
      "request": "depreciation .* sold|sold .* depreciation|disposal|gain.?loss on (?:sale|disposal)|depreciation.*residual|residual.*depreciation",
      "required": [],
      "require_all": [
        "cost",
        "residual_value",
        "useful_life",
        "years_elapsed",
        "sale_price"
      ],
      "require_any": [],
      "figures": [
        [
          "cost",
