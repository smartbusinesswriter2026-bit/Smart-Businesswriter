          1
        ],
        [
          "useful_life",
          "useful life",
          1
        ],
        [
          "years_elapsed",
          "year\\s*(\\d+)",
          1
        ],
        [
          "sale_price",
          "sold .* for|proceeds from (?:the )?(?:sale|disposal)|sale price|selling price",
          1
        ]
      ]
    },
    "ratio_computation": {
      "request": "current ratio|quick ratio|debt ratio|gross margin|net margin|return on assets|return on equity|asset turnover|receivables turnover|days sales outstanding",
      "required": [],
      "require_all": [
        "current_assets",
        "current_liabilities",
        "total_assets",
        "total_liabilities",
        "equity",
        "sales",
        "net_income",
        "accounts_receivable"
      ],
      "require_any": [],
      "figures": [
        [
          "current_assets",
          "current assets",
          1
        ],
        [
          "inventory",
          "inventory",
          1
        ],
        [
          "current_liabilities",
          "current liabilities",
          1
        ],
        [
          "total_assets",
          "total assets",
          1
        ],
        [
          "total_liabilities",
          "total liabilities",
          1
        ],
        [
          "equity",
          "\\bequity\\b",
          1
        ],
        [
          "sales",
          "\\bsales\\b",
          1
        ],
        [
          "cogs",
          "cogs|cost of goods sold",
          1
        ],
        [
          "net_income",
          "net income",
          1
        ],
        [
          "accounts_receivable",
          "accounts receivable",
          1
        ]
      ]
    }
  }
}