      "Borrowings",
      "",
      "financing",
      false
    ],
    [
      "^(trade payables?|payables?|creditors?|accounts? payable|sundry creditors|a/?p)$",
      "liability",
      "current",
      "Trade payables",
      "",
      "operating",
      false
    ],
    [
      "^(accrued expenses?|accruals?|accrued\\b.*)$",
