    {"id": "ctrl_five_forces", "taxonomy_id": "framework_five_forces", "label": "Five Forces", "kind": "framework", "expectation": "taught"},
    {"id": "ctrl_bcg", "taxonomy_id": "framework_bcg", "label": "BCG", "kind": "framework", "expectation": "taught"},
    {"id": "ctrl_errc", "taxonomy_id": "framework_errc", "label": "ERRC", "kind": "framework", "expectation": "taught"},
    {"id": "ctrl_bmc", "taxonomy_id": "framework_bmc", "label": "Business Model Canvas", "kind": "framework", "expectation": "taught"},
    {"id": "ctrl_ansoff", "taxonomy_id": "framework_ansoff", "label": "Ansoff", "kind": "framework", "expectation": "taught"},
    {"id": "ctrl_breakeven", "taxonomy_id": "computation_breakeven", "label": "Break-even", "kind": "capability", "expectation": "covered"},
    {"id": "ctrl_npv", "taxonomy_id": "computation_npv", "label": "Net Present Value", "kind": "capability", "expectation": "covered"},
