# Smart Business Writer: source credentials.
# Copy this file to Backend/.env and fill in the keys. Never commit the filled file.
# The loader reads only these names and never prints a value.

# Web researchers, in priority order:
# OpenGo (reserved) -> DeepSeek Search -> Brave -> Firecrawl.
DEEPSEEK_API_KEY=
OPENCODE_GO_MODEL=deepseek-v4.1-flash
PROSE_MODEL=deepseek-v4.1-flash
OPENGO_WEBSEARCH=0
OPENGO_RESEARCH=0
OPENGO_TIMEOUT=12
OPENCODE_API_KEY=
OPENGO_SEARCH_URL=
BRAVE_API_KEY=
FIRECRAWL_API_KEY=
# 1 = allow keyless Firecrawl (free daily allowance); 0 = require a key.
FIRECRAWL_KEYLESS=1

# Academic database.
SEMANTIC_SCHOLAR_API_KEY=

# Payments (PayPal subscriptions). Leave empty and checkout stays off: the pricing page
# reports which name is missing instead of showing a button that cannot work.
# PAYPAL_CLIENT_ID and PAYPAL_CLIENT_SECRET come from developer.paypal.com -> Apps &
# Credentials -> Live -> your app. The client id is public; the secret never leaves the server.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# live or sandbox. Live charges real cards, so it is the default.
PAYPAL_ENV=live

# The Business Bundle hand-off (owner instruction, 2026-11-03). The bundle is one order and one
# charge: the money is taken here, and the other product is granted the same bundle from the same
# PayPal vault, so it never takes a second payment. Leave these empty and the bundle still sells
# here - the account page then says the other product has not been told.
# The address of the hosted Write Smarter service, and the shared secret both products carry.
# The secret is server-side only and never leaves the server.
WRITE_SMARTER_URL=
BUNDLE_HANDOFF_SECRET=

# Contact addresses for the open APIs (Crossref and OpenAlex polite pools).
OPENALEX_EMAIL=
CROSSREF_MAILTO=

# Market data: one institutional Alpha Vantage key, shared by every user (free tier today;
# 25 requests/day). The product loads it as BP_ALPHAVANTAGE_KEY and uses it for equity quotes
# and price history. Leave it empty to keep the equity quote button disabled.
ALPHAVANTAGE_API_KEY=

# Second market-data provider: one institutional Massive key, shared by every user.
# The product loads it as BP_MASSIVE_API_KEY and uses it for a fallback/second price source.
# Leave it empty to keep the Massive provider disabled.
MASSIVE_API_KEY=
