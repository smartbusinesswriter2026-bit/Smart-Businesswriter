# Smart Business Writer: source credentials.
# Copy this file to Backend/.env and fill in the keys. Never commit the filled file.
# The loader reads only these names and never prints a value.

# Web researchers, in priority order:
# OpenGo (reserved) -> DeepSeek Search -> Brave -> Firecrawl.
DEEPSEEK_API_KEY=
OPENCODE_GO_MODEL=deepseek-v4.1-flash
OPENGO_WEBSEARCH=0
OPENGO_RESEARCH=0
OPENGO_TIMEOUT=12
OPENCODE_API_KEY=
OPENGO_SEARCH_URL=
BRAVE_API_KEY=
FIRECRAWL_API_KEY=
# 1 = allow keyless Firecrawl (free daily allowance); 0 = require a key.
FIRECRAWL_KEYLESS=1

# Academic database.
SEMANTIC_SCHOLAR_API_KEY=

# Contact addresses for the open APIs (Crossref and OpenAlex polite pools).
OPENALEX_EMAIL=
CROSSREF_MAILTO=
