# R2 credentials for the corpus bucket.
#
# Copy this file to corpus-db\build\_secrets\rclone_corpus.env and fill it in.
# The _secrets folder is gitignored: never commit the values below.
#
# Where the values come from - Cloudflare dashboard, R2 -> Manage R2 API Tokens:
#
#   1. Enable R2 for the account (the dashboard asks for this once).
#   2. Create an Account API token with the permission "Object Read & Write",
#      scoped to the bucket smart-business-writer-corpus.
#   3. The dashboard shows an Access Key ID and a Secret Access Key. Put both
#      below.
#
#   If you would rather paste the raw API token, use R2_API_TOKEN_ID and
#   R2_API_TOKEN_VALUE instead: the S3 access key id is the token id and the
#   S3 secret is the SHA-256 of the token value, which is what Cloudflare's
#   own recipe says to use.

R2_ACCOUNT_ID=00000000000000000000000000000000
R2_BUCKET=smart-business-writer-corpus

# Either this pair:
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Or this pair:
R2_API_TOKEN_ID=
R2_API_TOKEN_VALUE=
