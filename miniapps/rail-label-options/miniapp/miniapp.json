{
  "schemaVersion": 1,
  "artifacts": {
    "client": [
      "./miniapp/client"
    ],
    "node": [
      "./miniapp/node"
    ]
  },
  "runtime": {
    "kind": "process",
    "entry": "./miniapp/node/server.mjs",
    "lifecycle": "on-demand"
  },
  "surface": {
    "path": "/dashboard",
    "window": {
      "width": 560,
      "height": 900,
      "minWidth": 320,
      "minHeight": 360,
      "resizable": true,
      "frame": true,
      "transparent": false,
      "alwaysOnTop": false,
      "skipTaskbar": false,
      "clickThrough": false
    }
  },
  "mcpEndpoints": []
}
